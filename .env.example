# Copy this file to .env for local development.
# The real .env is never committed — see .gitignore.

# local | test | production
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# JSON array of origins allowed to call the API from a browser
CORS_ORIGINS=["http://localhost:5173"]

# Async SQLAlchemy connection string. This default matches docker-compose's
# local db service. Render's dashboard sets the real Neon pooled URL in prod —
# use Neon's *pooled* connection string, and keep postgresql+asyncpg:// as the scheme.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# --- Auth (dev-only insecure defaults -- Render's dashboard sets real ones) ---
JWT_SECRET=dev-only-insecure-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet.generate_key() output -- must stay 32 url-safe base64 bytes.
FERNET_KEY=10IAZaiwQMOJNknjWUejIEMlNgV2tEj9Chj22uyWOoE=

# --- Storage ---
# local | s3. local is filesystem-backed (tests, local dev). s3 is any
# S3-compatible object store; Render's dashboard switches this and sets the
# S3_* values.
#
# SPEC-v2 D12 chose Cloudflare R2 (10 GB free, zero egress) but R2 asks for a
# card at signup, so the shipped deployment uses Supabase Storage, which does
# not. The client is identical -- only the endpoint and region differ:
#
#   Supabase  endpoint https://<project-ref>.supabase.co/storage/v1/s3
#             region   your project's region, e.g. ap-south-1
#             keys     Storage -> S3 Access Keys in the dashboard
#
#   R2        endpoint https://<account-id>.r2.cloudflarestorage.com
#             region   auto
#             keys     an R2 API token scoped to the bucket
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.data/uploads

S3_BUCKET=ai-workspace-assistant-dev
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Embeddings ---
# fake | gemini. fake is a deterministic offline embedder needing no API key
# and no network, so a fresh clone and CI both ingest documents end to end.
# Set gemini (and GOOGLE_API_KEY) for real retrieval quality.
EMBEDDING_PROVIDER=fake
# Pinned deliberately: gemini-embedding-2 renormalises automatically at
# non-default dimensionalities, which gemini-embedding-001 did not.
EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_API_KEY=

# --- Background processing ---
# Both run inside the API process -- there is no separate worker on the free
# tier (SPEC-v2 D11). Turn the worker off to run the API read-only.
RUN_MIGRATIONS_ON_STARTUP=true
INGESTION_WORKER_ENABLED=true

# --- Chat model ---
# fake | gemini. fake answers deterministically from the retrieved excerpts,
# so the whole RAG path is testable with no key, no network and no bill.
LLM_PROVIDER=fake
# Passed to langchain's init_chat_model -- provider-agnostic, so switching to
# OpenAI is this one string. Not the gemini-2.5-flash SPEC-v2 pinned: Google
# now 404s that model for newly issued keys.
LLM_MODEL=google_genai:gemini-3.6-flash

# --- Email (SPEC-v2 D16) ---
# console | resend. console records and logs the message instead of sending
# it, so a fresh clone can drive an approved action end to end with no API key
# and nothing arriving in a stranger's inbox. Production sets resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Resend only sends from a verified domain, or from its own onboarding sender
# -- which is what makes a demo possible at zero cost. Reply-To is set per
# message to the person who requested the action, never to this address.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=AI Workspace Assistant

# --- Calendar (SPEC-v2 D17) ---
# ics | google. ics builds an RFC 5545 invitation and attaches it to the
# notification email, which needs no OAuth from anyone. google is declared
# behind the same interface and deliberately not shipped -- calendar.events is
# a sensitive scope with multi-week verification.
CALENDAR_PROVIDER=ics

# --- Agent ---
# memory | postgres. Where LangGraph keeps the agent's paused state. Production
# uses postgres so an approval left overnight survives the service spinning
# down; tests use memory, since the checkpointer commits on its own connections
# outside the per-test rollback.
AGENT_CHECKPOINTER=postgres
