# Copy this file to .env for local development.
# The real .env is never committed — see .gitignore.

# local | test | production
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# JSON array of origins allowed to call the API from a browser
CORS_ORIGINS=["http://localhost:5173"]

# Async SQLAlchemy connection string. This default matches docker-compose's
# local db service. Render's dashboard sets the real Neon pooled URL in prod —
# use Neon's *pooled* connection string, and keep postgresql+asyncpg:// as the scheme.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
