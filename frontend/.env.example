# Where the API lives. No trailing slash.
#
# Local development against the Docker Compose or uvicorn backend:
VITE_API_URL=http://localhost:8000

# In production this is the Render service, set as a Cloudflare Workers build
# variable rather than committed -- Vite inlines it at build time, so a runtime
# binding would be read far too late:
#   VITE_API_URL=https://ai-workspace-assistant-2.onrender.com
#
# Whatever this points at must list this SPA's origin in the API's
# CORS_ORIGINS. The refresh cookie is cross-site, so the browser will only
# send it to an origin the API has explicitly allowed.
